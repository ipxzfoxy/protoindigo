{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Breeze",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.breeze",
          "match": "\\b(new|const|proto)\\b"
        },
        {
          "name": "constant.language.boolean.breeze",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [{
        "name": "entity.name.type.breeze",
        "match": "#[a-zA-Z_][a-zA-Z0-9_]*"
      }]
    },
    "operators": {
      "patterns": [{
        "name": "keyword.operator.assignment.breeze",
        "match": "="
      }]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.breeze",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.breeze", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.breeze",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.breeze", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.template.breeze",
          "begin": "`",
          "end": "`",
          "patterns": [{ "name": "constant.character.escape.breeze", "match": "\\\\." }]
        }
      ]
    },
    "numbers": {
      "patterns": [{
        "name": "constant.numeric.integer.breeze",
        "match": "\\b[0-9]+\\b"
      }]
    },
    "comments": {
      "patterns": [{
        "name": "comment.line.double-slash.breeze",
        "match": "//.*$"
      }]
    }
  },
  "scopeName": "source.breeze"
}
