proto "Welcome to ProtoIndigo";
proto "";
proto "Usage:";
proto "  indigo              Start the Indigo REPL";
proto "  indigo run <file>   Execute an Indigo source file";
proto "";
proto "Commands:";
proto "  help                Show this help message";
proto "  -v                  Show version information";
proto "  platform            Show platform version";
proto "  --tokenize          Tokenize a .bre file and display the result";
proto "  --parse             Parse a .bre file";
proto "";
proto "Examples:";
proto "  indigo";
proto "  indigo run hello.bre";
proto "";
proto "https://github.com/ipxzfoxy/protoindigo";
proto "(c) 2026 Victor Botelho Anunciacao";